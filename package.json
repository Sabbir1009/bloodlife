{
  "name": "blood",
  "version": "1.0.0",
  "description": "Blood Donation Management System - A modern platform connecting blood donors with patients in need",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "seed": "node seed-demo-data.js",
    "build": "node --check server.js && node --check config/database.js && node --check routes/admin.js && node --check routes/donors.js && node --check routes/requests.js && node --check routes/donorAuth.js && node --check routes/neon.js && node --check utils/notificationService.js"
  },
  "keywords": [
    "blood-donation",
    "healthcare",
    "nodejs",
    "express",
    "mysql"
  ],
  "author": "aldrik-cruze",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@neon/realtime": "^0.1.2",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jest": "^30.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.1",
    "pg": "^8.23.1",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
